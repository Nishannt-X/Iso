#!/usr/bin/env bash
# Enforces Conventional Commits 1.0.0 on the subject line (git hook; works for humans and every agent).
msg_file="$1"
subject=$(grep -v '^#' "$msg_file" | sed -n '1p')
case "$subject" in Merge\ *|Revert\ *|fixup!*|squash!*) exit 0 ;; esac
re='^(feat|fix|docs|style|refactor|perf|test|build|ci|chore|revert)(\([a-z0-9._/-]+\))?!?: .+'
if ! printf '%s' "$subject" | grep -Eq "$re"; then
  echo "commit-msg: subject must be '<type>(scope)?: <description>' with type in feat|fix|docs|style|refactor|perf|test|build|ci|chore|revert" >&2
  echo "got: $subject" >&2; exit 1
fi
if [ "${#subject}" -gt 72 ]; then echo "commit-msg: subject is ${#subject} chars; keep ≤72" >&2; exit 1; fi
exit 0
