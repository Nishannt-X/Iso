#!/usr/bin/env bash
# Blocks commits on protected branches and obvious secrets/forbidden files in the staged set.
br=$(git branch --show-current 2>/dev/null)
case "$br" in main|master) echo "pre-commit: commits on '$br' are blocked. Create a feature branch." >&2; exit 1 ;; esac

staged=$(git diff --cached --name-only --diff-filter=ACM)
bad=$(printf '%s\n' "$staged" | grep -E '(^|/)(\.env(\..*)?|.*\.pem|.*\.key|id_rsa.*|CLAUDE\.local\.md)$' | grep -v -E '\.env\.example$')
if [ -n "$bad" ]; then echo "pre-commit: forbidden files staged:" >&2; echo "$bad" >&2; exit 1; fi

if [ -n "$staged" ] && git diff --cached -U0 -- $staged | grep -E '^\+' | grep -Eq '(AKIA[0-9A-Z]{16}|-----BEGIN [A-Z ]*PRIVATE KEY-----|ghp_[A-Za-z0-9]{30,}|sk-[A-Za-z0-9]{20,}|xox[baprs]-[A-Za-z0-9-]{10,})'; then
  echo "pre-commit: possible secret in staged changes. Remove it and rotate if it was real." >&2; exit 1
fi
exit 0
