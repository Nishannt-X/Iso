{
  "name": "kochi-tours",
  "version": "0.1.0",
  "private": true,
  "description": "Company A Kochi tour operator: package catalogue, seasonal pricing, CMS versioning and AI-assisted enquiry triage",
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/server.ts",
    "start": "node --env-file-if-exists=.env dist/server.js",
    "build": "tsc -p tsconfig.build.json && cp src/db/schema.sql dist/db/schema.sql && mkdir -p dist/public && cp -R src/public/. dist/public/",
    "test": "node --import tsx --test \"tests/**/*.test.ts\"",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "db:reset": "tsx --env-file-if-exists=.env scripts/db-reset.ts"
  },
  "dependencies": {
    "@hono/node-server": "2.1.5",
    "hono": "4.13.16",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "22.20.5",
    "eslint": "10.14.0",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1"
  }
}
