# Configuration for Company A Kochi Tour Operator
# Copy to .env for local overrides: cp .env.example .env

PORT=3000
DATA_DIR=./data
DB_PATH=data/kochi-tours.db
SITE_URL=http://localhost:3000
TRUST_PROXY=0

# Demo password for reviewer login (activates seeded staff accounts on db:reset)
DEMO_STAFF_PASSWORD=demo-staff-password

# Optional: Google Gemini API key for live AI enquiry triage (fallback rules engine is used if omitted)
# GEMINI_API_KEY=
